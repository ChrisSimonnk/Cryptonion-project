# ==============================================================================
# CRYPTONION ENVIRONMENT CONFIGURATION
# ==============================================================================

# General
NODE_ENV=development
APP_NAME=Cryptonion
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
AI_SERVICE_URL=http://localhost:8000

# PostgreSQL + pgvector
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cryptonion
DB_USER=cryptonion
DB_PASSWORD=cryptonion_secret
DATABASE_URL=postgresql://cryptonion:cryptonion_secret@localhost:5432/cryptonion

# Redis (Caching & BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# MinIO / S3 Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cryptonion-storage
S3_REGION=us-east-1
S3_USE_SSL=false

# Ollama LLM Service
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=llama3:8b

# Knowledge & RAG Embeddings (Phase 5 Canonical Configuration)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSION=1536
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Faster Whisper STT & Piper TTS
STT_MODEL_SIZE=base
TTS_VOICE_MODEL=en_US-lessac-medium

# Telephony (Asterisk)
ASTERISK_HOST=localhost
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=admin
ASTERISK_AMI_SECRET=amp111

# Security & JWT
JWT_SECRET=super_secret_cryptonion_jwt_key_32bytes_minimum_length_required
SESSION_SECRET=session_cryptonion_cookie_secret_value_must_be_long_enough
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
